# Keep home-directory files private unless explicitly allowlisted.
/*
!/.gitignore

# Track shared configuration sources, not migration backups or runtime files.
!/.ai/
/.ai/*
!/.ai/README.md
!/.ai/build.py
!/.ai/test_build.py
!/.ai/test_setup.py
!/.ai/shared/
!/.ai/pi/
!/.ai/opencode/

!/.config/
/.config/*
!/.config/ghostty/

# Kitty: track the config and the theme it includes. Kittens, plugins and
# downloaded themes stay out of the repo.
!/.config/kitty/
/.config/kitty/*
!/.config/kitty/kitty.conf
!/.config/kitty/current-theme.conf
!/.config/nvim/
!/.config/opencode/
!/.config/starship/
!/.config/starship.toml

# Berkeley Mono: allow-list only the installed font file itself, so other
# font directories (including cloned ones) stay out of the repo.
!/.local/
/.local/*
!/.local/share/
/.local/share/*
!/.local/share/fonts/
/.local/share/fonts/*
!/.local/share/fonts/berkeley-mono/
/.local/share/fonts/berkeley-mono/*
!/.local/share/fonts/berkeley-mono/BerkeleyMonoVariable.woff2

# Flagged by the secret-pattern scan; keep private pending manual review.
/.config/opencode/service.json
/.pi/agent/extensions/message-board/integration.test.mjs

# Pi runtime and connection settings may contain credentials or private history.
!/.pi/
/.pi/*
!/.pi/AGENTS.md
!/.pi/docs/
!/.pi/agent/
/.pi/agent/*
!/.pi/agent/AGENTS.md
!/.pi/agent/SYSTEM.md
!/.pi/agent/extensions/
!/.pi/agent/prompts/
!/.pi/agent/skills/
!/.pi/agent/themes/

# Apply these exclusions within every allowlisted directory too.
**/node_modules/
**/.git/
**/.opencode/
**/.env
**/.env.*
**/*auth*
**/*credential*
**/*secret*
**/*token*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/*.bak
**/*.log
**/*.sqlite*
**/*.db
**/__pycache__/
**/.cache/
**/tmp/

# Reviewed instructional resources, not saved authentication state.
!/.ai/shared/skills/agent-browser/references/authentication.md
!/.ai/shared/skills/agent-browser/templates/authenticated-session.sh
